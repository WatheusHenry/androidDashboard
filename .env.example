# Porta HTTP do dashboard/API
PORT=8080

# Bind address — 0.0.0.0 permite acesso de outros dispositivos da rede local
HOST=0.0.0.0

# Intervalo de coleta das métricas (ms)
COLLECT_INTERVAL=5000

# Intervalo de gravação do histórico no SQLite (ms) — evite valores muito baixos
HISTORY_INTERVAL=60000

# Caminho do banco SQLite
DATABASE_PATH=./data/monitor.db

# Retenção do histórico (dias)
HISTORY_RETENTION_DAYS=7

# Mount monitorado como armazenamento principal (Termux usa /data)
STORAGE_PATH=/data

# Modo mock (dados falsos p/ desenvolver sem Android): 1 para ativar
# MOCK_DATA=1

# ===== Terminal web =====
# ATENÇÃO: habilitado sem token, qualquer dispositivo da rede local executa comandos.
TERMINAL_ENABLED=1

# Token obrigatório para usar o terminal (RECOMENDADO definir um valor forte)
# TERMINAL_TOKEN=troque-este-token

# Shell usado no terminal (padrão: bash)
TERMINAL_SHELL=bash

# Encerra sessões ociosas após (ms) — padrão 10 min
TERMINAL_IDLE_TIMEOUT=600000

# Máximo de sessões simultâneas
TERMINAL_MAX_SESSIONS=2
